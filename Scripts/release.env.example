# App Store Connect API key used to notarize releases.
# Copy to ~/.config/sorla/release.env (or point SORLA_RELEASE_CONFIG at it)
# and fill in your own values. Never commit the filled-in file or the key.
ASC_KEY_PATH="$HOME/.config/asc/AuthKey_XXXXXXXXXX.p8"
ASC_KEY_ID="XXXXXXXXXX"
ASC_ISSUER_ID="00000000-0000-0000-0000-000000000000"
