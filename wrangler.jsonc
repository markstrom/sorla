{
  // Static site only: no Worker script, no bindings. Deploy with Scripts/deploy-site.sh.
  "name": "sorla",
  "compatibility_date": "2026-09-23",
  "routes": [
    { "pattern": "sorla.zerolabs.se", "custom_domain": true }
  ],
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
